# Copy to .env and change the password. Never commit .env.
APP_PASSWORD=change-me-to-something-long

# Signs the session cookie. Leave empty and it is derived from APP_PASSWORD,
# which means changing the password logs everyone out. Set it explicitly if you
# want to rotate the password without ending sessions.
APP_SECRET=

# Used only by the optional Caddy proxy (docker compose --profile tls).
# Point an A record at the VPS first, otherwise certificate issuance fails.
DOMAIN=lab.example.com

# 168 hours is 7 days.
SESSION_HOURS=168

# 1 behind HTTPS. Set 0 only if you are testing over plain HTTP on localhost.
SECURE_COOKIE=1

# Optional: only allow these source IPs, comma separated. Empty means everyone.
ALLOWED_IPS=
